{
  "brokers": [
    {
      "name": "openai",
      "clients": [
        "agent-dev"
      ],
      "issuer_host": "auth.openai.com",
      "token_path": "/oauth/token",
      "api_hosts": [
        "chatgpt.com"
      ],
      "access_token_field": "access_token",
      "refresh_token_field": "refresh_token"
    },
    {
      "name": "anthropic",
      "clients": [
        "agent-dev"
      ],
      "issuer_host": "platform.claude.com",
      "token_path": "/v1/oauth/token",
      "api_hosts": [
        "api.anthropic.com"
      ],
      "access_token_field": "access_token",
      "refresh_token_field": "refresh_token"
    },
    {
      "name": "antigravity",
      "clients": [
        "agent-dev"
      ],
      "issuer_host": "oauth2.googleapis.com",
      "token_path": "/token",
      "api_hosts": [
        "*.googleapis.com"
      ],
      "access_token_field": "access_token",
      "refresh_token_field": "refresh_token"
    }
  ]
}
