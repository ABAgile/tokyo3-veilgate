# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Local secrets and generated interception CA material
.env
/config/clients.json
/config/secrets.json
/config/oauth.json
/config/auth.json
/config/intercept-ca.crt
/config/intercept-ca.key
/config/proxy.crt
/config/proxy.key
/config/console.crt
/config/console.key
/var/

# Local review logs and working notes
/docs/reviews/

# Editor/IDE
# .idea/
# .vscode/
